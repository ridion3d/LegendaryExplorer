<misc:NotifyPropertyChangedWindowBase
        x:Class="LegendaryExplorer.Dialogs.CheckboxListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:misc="clr-namespace:LegendaryExplorer.Misc"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="{Binding TitleText}" SizeToContent="Height" Width="500">
    <StackPanel Margin="5" HorizontalAlignment="Stretch">
        <StackPanel.Resources>
            <ItemsPanelTemplate x:Key="VSP">
                <VirtualizingStackPanel/>
            </ItemsPanelTemplate>
        </StackPanel.Resources>

        <TextBlock Text="{Binding DirectionsText}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
        <ListBox Name="EntrySelector_List"
         ItemsSource="{Binding Items}"
         ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Label}"
                      IsChecked="{Binding IsChecked}"
                      Margin="0,2,0,2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="All" Width="60" Margin="0,0,5,0" Click="SelectAll_Click"/>
            <Button Content="None" Width="60" Click="SelectNone_Click"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK"  Width="40" Command="{Binding OKCommand}"/>
            <Button Content="Cancel" Padding="5,3" Margin="5,0" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</misc:NotifyPropertyChangedWindowBase>
